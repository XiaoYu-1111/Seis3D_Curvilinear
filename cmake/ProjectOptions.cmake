include_guard(GLOBAL)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
option(SEIS3D_BUILD_GUI "Build the independent ImGui/OpenGL workbench" ON)
option(SEIS3D_BUILD_VALIDATION "Build numerical and configuration checks" ON)
option(SEIS3D_ENABLE_OPENMP "Enable CPU stencil parallelism when OpenMP is available" ON)
option(SEIS3D_ENABLE_CUDA "Build the Float64 CUDA backend; CPU is always retained" OFF)
if(SEIS3D_ENABLE_CUDA AND NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
    set(CMAKE_CUDA_ARCHITECTURES "75-real;86-real;89-real;120-real;75-virtual" CACHE STRING "CUDA architectures for RTX 20/30/40/50 and forward-compatible PTX")
endif()
if(SEIS3D_BUILD_VALIDATION)
    # Required at the outer level for ctest --preset to discover child tests.
    enable_testing()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MsvcDependencies.cmake")
